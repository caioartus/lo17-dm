@startuml

skinparam defaultFontName Helvetica

skinparam class {
    BackgroundColor White
    BorderColor #555555
    BorderThickness 1.5
    HeaderBackgroundColor #DDEEFF
    FontStyle bold
    AttributeFontSize 11
    AttributeFontColor #222222
    StereotypeFontColor #555555
    StereotypeFontSize 11
}

skinparam arrow {
    Color #444444
    FontColor #444444
    FontSize 11
    Thickness 1.2
}

skinparam note {
    BackgroundColor #FFFDE7
    BorderColor #999900
    FontSize 11
}

skinparam shadowing false
skinparam roundCorner 8
skinparam nodesep 80
skinparam ranksep 30

class "parse_corpus.py" <<script>> {
    --
    args : -input, -outdir
}

class "make_index.py" <<script>> {
}

class BulletinParser {
    - path         : Path
    - content      : str
    - soup         : BeautifulSoup
    - dom          : _Element
    - title        : str
    - rubrique     : str
    - date         : str
    - num_article  : str
    - num_buletin  : str
    - text         : str
    - images       : list[dict]
    - info_contact : str
    - org          : str | None
    - name         : str | None
    - email        : str | None
    ---
    + load() : void
    + extract_data() : void
    + makeXML() : str
}

note left of BulletinParser
    Gère l'extraction d'un unique
    fichier HTML via XPath.
    Le parsing HTML est réalisé en
    deux passes : BeautifulSoup
    puis etree.
end note

class CorpusParser {
    - folder_path : Path
    - documents   : list[BulletinParser]
    - xml_str     : str
    ---
    + parseFiles() : void
    + makeXML() : str
    + save_xml(path : str | Path) : void
}

class CorpusTokenizer {
    - xml_path : str | None
    - tree     : ElementTree | None
    - table    : DataFrame | None
    ---
    + load_xml(path : str | Path) : void
    + tokenize_corpus() : void
    + save_table(directory : str | Path) : void
    + get_table() : DataFrame | None

    + {static} simplify(sent : str) : str
    + {static} simplify_many(tokenlist : list[str]) : list[str]
    + {static} tokenize(text : str) : list[str]
}

class Index {
    - xml_tree   : _Element | None
    - index_dict : dict
    ---
    + load_xml(path : str | Path) : void
    + build(output_dir : str | Path) : void
    + save_to_tsv(output_dir : str | Path) : void

    - get_required(elem : _Element | None, name : str) : str
    - add_raw(text : str, doc_id : int,\n  index_dict : dict, section : str) : dict
    - treat_field(text : str, doc_id : int,\n  index_dict : dict, section : str) : dict
}

note top of Index
    Construit les fichiers inverses
    à partir du corpus XML.
    Distingue champs tokenisés
    (titre, texte) et champs bruts
    (date, rubrique, auteur...).
end note

"parse_corpus.py" ..> CorpusParser     : «instantiates»
"make_index.py"   ..> Index            : «instantiates»

CorpusParser *--  BulletinParser
Index <.  CorpusParser : «produces XML consumed by»
Index             ..>  CorpusTokenizer     : «uses»

@enduml
